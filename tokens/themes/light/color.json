      "$value": "{primitive.light.alpha.blue-700-18}",
      "$extensions": {
        "bds": {
          "css": "lamp-grid-major"
        }
      }
    },
    "lamp-glow": {
      "$value": "{primitive.light.alpha.blue-700-3}",
      "$extensions": {
        "bds": {
          "css": "lamp-glow"
        }
      }
